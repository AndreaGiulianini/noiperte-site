/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; frame-src https://www.openstreetmap.org https://www.facebook.com https://www.instagram.com; connect-src 'self' https://formspree.io https://formsubmit.co; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'self'
  X-DNS-Prefetch-Control: off
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Cache lunga solo per i file che cambiano nome quando cambiano contenuto.
# CSS, JS e pagine tengono lo stesso nome: restano sulla revalidazione di default
# (public, max-age=0, must-revalidate), così le modifiche arrivano subito.
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/video/*
  Cache-Control: public, max-age=31536000, immutable

/sitemap.xml
  Cache-Control: public, max-age=3600
